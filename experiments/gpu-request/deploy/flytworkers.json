                  "profileRef",
                  "controlPlaneRef"
                ],
                "properties": {
                  "vmiRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 36,
                        "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                      }
                    }
                  },
                  "profileRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 36,
                        "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                      }
                    }
                  },
                  "controlPlaneRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 36,
                        "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                      }
                    }
                  },
                  "suspend": {
                    "type": "boolean",
                    "default": false
                  },
                  "request": {
                    "type": "object",
                    "required": [
                      "requestRef",
                      "generation",
                      "vmRef",
                      "resources"
                    ],
                    "properties": {
                      "requestRef": {
                        "type": "object",
                        "required": [
                          "name",
                          "uid"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 253,
                            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                          },
                          "uid": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 36,
                            "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                          }
                        }
                      },
                      "generation": {
                        "type": "integer",
                        "format": "int64",
                        "minimum": 1
                      },
                      "vmRef": {
                        "type": "object",
                        "required": [
                          "name",
                          "uid"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 253,
                            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                          },
                          "uid": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 36,
                            "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                          }
