{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "flytworkers.flyt.dev"
  },
  "spec": {
    "group": "flyt.dev",
    "scope": "Namespaced",
    "names": {
      "kind": "FlytWorker",
      "listKind": "FlytWorkerList",
      "plural": "flytworkers",
      "singular": "flytworker",
      "shortNames": [
        "fw"
      ]
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Ready",
            "type": "string",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status"
          },
          {
            "name": "VMI",
            "type": "string",
            "jsonPath": ".spec.vmiRef.name"
          },
          {
            "name": "Profile",
            "type": "string",
            "jsonPath": ".spec.profileRef.name"
          },
          {
            "name": "PodIP",
            "type": "string",
            "jsonPath": ".status.podIP"
          },
          {
            "name": "Age",
