                        "properties": {
                          "count": {
                            "type": "integer",
                            "format": "int32",
                            "enum": [
                              1
                            ]
                          },
                          "compute": {
                            "type": "integer",
                            "format": "int32",
                            "minimum": 1,
                            "maximum": 100
                          },
                          "memoryMiB": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 256,
                            "maximum": 1048576
                          }
                        }
                      }
                    }
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "self.vmiRef == oldSelf.vmiRef",
                    "message": "vmiRef is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.profileRef == oldSelf.profileRef",
                    "message": "profileRef is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.controlPlaneRef == oldSelf.controlPlaneRef",
                    "message": "controlPlaneRef is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "has(self.request) == has(oldSelf.request) && (!has(self.request) || self.request == oldSelf.request)",
                    "message": "request allocation is immutable, including presence; a new VMI is required for changed requests"
                  }
                ]
              },
              "status": {
                "type": "object",
                "properties": {
                  "observedGeneration": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "phase": {
                    "type": "string",
                    "enum": [
                      "Pending",
                      "Ready",
                      "Blocked",
                      "Suspended",
                      "Terminating"
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "x-kubernetes-list-type": "map",
                    "x-kubernetes-list-map-keys": [
                      "type"
                    ],
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "status",
                        "lastTransitionTime",
                        "reason",
                        "message"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 316
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "True",
                            "False",
                            "Unknown"
                          ]
                        },
                        "lastTransitionTime": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 8192
                        },
                        "observedGeneration": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    }
                  },
                  "consumers": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "podUID": {
                    "type": "string"
                  },
                  "podIP": {
                    "type": "string"
                  },
                  "vmIP": {
                    "type": "string"
                  },
                  "workerGeneration": {
                    "type": "string"
                  },
                  "managerEpoch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
