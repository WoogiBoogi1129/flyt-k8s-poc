FROM docker.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04@sha256:ad6d59a3bbf3e82c1c849c9ac09cfc2a3e0bbb8655042fd899be6681b3fe2a85 AS build
ARG CUDA_ARCH=sm_120
WORKDIR /build
COPY probe.cu ./probe.cu
RUN nvcc -O2 -std=c++17 --cudart shared -arch=${CUDA_ARCH} probe.cu -o /probe

FROM docker.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04@sha256:17e2934e1fa96152b14f78078bfbafd0f00f391df995dc6c641a720fce1202bb
COPY --from=build /probe /opt/hami-stage1/probe
ENTRYPOINT ["/opt/hami-stage1/probe"]
