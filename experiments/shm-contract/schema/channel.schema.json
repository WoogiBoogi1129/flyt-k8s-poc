{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flyt:shm:channel-contract:1",
  "title": "Proposed channel allocation record; not an installed Kubernetes CRD",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "allocationId", "vmUID", "requestUID", "requestGeneration", "nodeName", "channelGeneration", "phase", "regionBytes", "sessionLimit", "deviceBackend"],
  "properties": {
    "protocol": {"const": "flyt-shm-control-v1"},
    "allocationId": {"$ref": "#/$defs/id"},
    "vmUID": {"$ref": "#/$defs/uid"},
    "requestUID": {"$ref": "#/$defs/uid"},
    "requestGeneration": {"type": "integer", "minimum": 1},
    "nodeName": {"type": "string", "minLength": 1, "maxLength": 253},
    "channelGeneration": {"$ref": "#/$defs/id"},
    "phase": {"enum": ["Reserved", "BackingReady", "Bound", "Ready", "Draining", "Released", "Failed"]},
    "regionBytes": {"type": "integer", "minimum": 1048576, "maximum": 4294967296, "multipleOf": 4096},
    "sessionLimit": {"type": "integer", "minimum": 1, "maximum": 32},
    "deviceBackend": {"const": "ivshmem-candidate"},
    "vmiUID": {"$ref": "#/$defs/uid"},
    "workerUID": {"$ref": "#/$defs/uid"},
    "podUID": {"$ref": "#/$defs/uid"},
    "workerGeneration": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"enum": ["Bound", "Ready"]}}},
     "then": {"required": ["vmiUID", "workerUID", "podUID", "workerGeneration"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "uid": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9-]+$"}
  }
}
