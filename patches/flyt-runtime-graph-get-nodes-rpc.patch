-DEF_FN(cudaError_t, cudaGraphGetNodes, cudaGraph_t, graph, cudaGraphNode_t*, nodes, size_t*, numNodes)
+cudaError_t cudaGraphGetNodes(cudaGraph_t graph, cudaGraphNode_t *nodes,
+                              size_t *numNodes)
+{
+    if (numNodes == NULL) return cudaErrorInvalidValue;
+    size_t capacity = nodes == NULL ? 0 : *numNodes;
+    mem_result result = {0};
+    enum clnt_stat retval = cuda_graph_get_nodes_1((ptr)graph, &result, clnt);
+    if (retval != RPC_SUCCESS) return cudaErrorUnknown;
+    if (result.err != cudaSuccess) return result.err;
+    mem_data *data = &result.mem_result_u.data;
+    if (data->mem_data_len < sizeof(uint64_t)) return cudaErrorUnknown;
+    uint64_t count = 0;
+    memcpy(&count, data->mem_data_val, sizeof(count));
+    if (count > (data->mem_data_len - sizeof(count)) / sizeof(ptr)) {
+        return cudaErrorUnknown;
+    }
+    if (nodes == NULL) {
+        *numNodes = (size_t)count;
+        return cudaSuccess;
+    }
+    size_t copied = capacity < count ? capacity : (size_t)count;
+    memcpy(nodes, data->mem_data_val + sizeof(count), copied * sizeof(ptr));
+    *numNodes = copied;
+    return cudaSuccess;
+}
