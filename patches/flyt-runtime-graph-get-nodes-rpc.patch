+bool_t cuda_graph_get_nodes_1_svc(ptr graph, mem_result *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    size_t count = 0;
+    result->err = cuGraphGetNodes((CUgraph)graph, NULL, &count);
+    if (result->err != CUDA_SUCCESS) {
+        GSCHED_RELEASE;
+        return 1;
+    }
+    if (count > (SIZE_MAX - sizeof(uint64_t)) / sizeof(CUgraphNode)) {
+        result->err = cudaErrorInvalidValue;
+        GSCHED_RELEASE;
+        return 1;
+    }
+    size_t bytes = sizeof(uint64_t) + count * sizeof(CUgraphNode);
+    char *wire = malloc(bytes);
+    if (wire == NULL) {
+        result->err = cudaErrorMemoryAllocation;
+        GSCHED_RELEASE;
+        return 1;
+    }
+    size_t returned = count;
+    if (count != 0) {
+        result->err = cuGraphGetNodes((CUgraph)graph,
+                                      (CUgraphNode *)(wire + sizeof(uint64_t)),
+                                      &returned);
+    }
+    if (result->err == CUDA_SUCCESS) {
+        uint64_t wire_count = returned;
+        memcpy(wire, &wire_count, sizeof(wire_count));
+        result->mem_result_u.data.mem_data_val = wire;
+        result->mem_result_u.data.mem_data_len =
+            sizeof(uint64_t) + returned * sizeof(CUgraphNode);
+    } else {
+        free(wire);
+    }
+    GSCHED_RELEASE;
+    return 1;
+}
