+cusparseStatus_t cusparseCreateCsr(cusparseSpMatDescr_t*d,int64_t rows,int64_t cols,int64_t nnz,void*ro,void*ci,void*v,cusparseIndexType_t rt,cusparseIndexType_t ct,cusparseIndexBase_t ib,cudaDataType vt){CREATE(rpc_cusparsecreatecsr_1(rows,cols,nnz,(ptr)ro,(ptr)ci,(ptr)v,rt,ct,ib,vt,&r,clnt),d);}
+cusparseStatus_t cusparseCsrSetPointers(cusparseSpMatDescr_t d,void*ro,void*ci,void*v){CALL(rpc_cusparsecsrsetpointers_1((ptr)d,(ptr)ro,(ptr)ci,(ptr)v,&r,clnt));}
+cusparseStatus_t cusparseDestroySpMat(cusparseConstSpMatDescr_t d){CALL(rpc_cusparsedestroyspmat_1((ptr)d,&r,clnt));}
+cusparseStatus_t cusparseCreateDnMat(cusparseDnMatDescr_t*d,int64_t rows,int64_t cols,int64_t ld,void*v,cudaDataType vt,cusparseOrder_t o){CREATE(rpc_cusparsecreatednmat_1(rows,cols,ld,(ptr)v,vt,o,&r,clnt),d);}
+cusparseStatus_t cusparseDestroyDnMat(cusparseConstDnMatDescr_t d){CALL(rpc_cusparsedestroydnmat_1((ptr)d,&r,clnt));}
+cusparseStatus_t cusparseSpMM_bufferSize(cusparseHandle_t h,cusparseOperation_t a,cusparseOperation_t b,const void*alpha,cusparseConstSpMatDescr_t A,cusparseConstDnMatDescr_t B,const void*beta,cusparseDnMatDescr_t C,cudaDataType t,cusparseSpMMAlg_t alg,size_t*size){cudnn_scaling_t x,y;if(!size||scalar(t,alpha,&x)||scalar(t,beta,&y))return CUSPARSE_STATUS_NOT_SUPPORTED;sz_result r={.err=CUSPARSE_STATUS_INTERNAL_ERROR};if(rpc_cusparsespmm_buffersize_1((ptr)h,a,b,x,(ptr)A,(ptr)B,y,(ptr)C,t,alg,&r,clnt)!=RPC_SUCCESS)return CUSPARSE_STATUS_INTERNAL_ERROR;if(!r.err)*size=r.sz_result_u.data;return r.err;}
