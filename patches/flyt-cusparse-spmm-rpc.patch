+static int scalar(cudaDataType t,const void *p,cudnn_scaling_t *v){
+    v->dataType=t;
+    if(t==CUDA_R_32F){v->cudnn_scaling_t_u.f=*(const float*)p;return 0;}
+    if(t==CUDA_R_64F){v->cudnn_scaling_t_u.d=*(const double*)p;return 0;}
+    return -1;
+}
+#define CALL(expr) do{int r=CUSPARSE_STATUS_INTERNAL_ERROR;if((expr)!=RPC_SUCCESS)return CUSPARSE_STATUS_INTERNAL_ERROR;return r;}while(0)
+cusparseStatus_t cusparseCreate(cusparseHandle_t *h){ptr_result r={.err=CUSPARSE_STATUS_INTERNAL_ERROR};if(!h)return CUSPARSE_STATUS_INVALID_VALUE;if(rpc_cusparsecreate_1(&r,clnt)!=RPC_SUCCESS)return CUSPARSE_STATUS_INTERNAL_ERROR;if(!r.err)*h=(void*)r.ptr_result_u.ptr;return r.err;}
+cusparseStatus_t cusparseDestroy(cusparseHandle_t h){CALL(rpc_cusparsedestroy_1((ptr)h,&r,clnt));}
+cusparseStatus_t cusparseSetStream(cusparseHandle_t h,cudaStream_t s){CALL(rpc_cusparsesetstream_1((ptr)h,(ptr)s,&r,clnt));}
+cusparseStatus_t cusparseSetPointerMode(cusparseHandle_t h,cusparsePointerMode_t m){CALL(rpc_cusparsesetpointermode_1((ptr)h,m,&r,clnt));}
+#define CREATE(call,out) do{ptr_result r={.err=CUSPARSE_STATUS_INTERNAL_ERROR};if((call)!=RPC_SUCCESS)return CUSPARSE_STATUS_INTERNAL_ERROR;if(!r.err)*(out)=(void*)r.ptr_result_u.ptr;return r.err;}while(0)
