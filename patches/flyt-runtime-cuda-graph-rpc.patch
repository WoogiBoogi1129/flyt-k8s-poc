+bool_t cuda_stream_begin_capture_1_svc(ptr stream, int mode, int *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    cudaStream_t stream_ptr;
+    GET_CLIENT(*result)
+    GET_STREAM(stream_ptr, stream, *result)
+    /*
+     * ONC RPC does not guarantee that consecutive requests from one guest
+     * are dispatched by the same host thread.  CUDA requires begin/end to
+     * run on the same thread for GLOBAL and THREAD_LOCAL capture modes.
+     * The guest proxy already serializes the caller's CUDA API sequence, so
+     * use RELAXED on the server to make capture transport-thread agnostic.
+     */
+    (void)mode;
+    *result = cuStreamBeginCapture((CUstream)stream_ptr,
+                                   CU_STREAM_CAPTURE_MODE_RELAXED);
+    GSCHED_RELEASE;
+    return 1;
+}
+
+bool_t cuda_stream_end_capture_1_svc(ptr stream, ptr_result *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    cudaStream_t stream_ptr;
+    GET_CLIENT(result->err)
+    GET_STREAM(stream_ptr, stream, result->err)
+    CUgraph graph = NULL;
+    result->err = cuStreamEndCapture((CUstream)stream_ptr, &graph);
+    if (result->err == cudaSuccess) result->ptr_result_u.ptr = (ptr)graph;
+    GSCHED_RELEASE;
+    return 1;
+}
+
+bool_t cuda_graph_destroy_1_svc(ptr graph, int *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    *result = cuGraphDestroy((CUgraph)graph);
+    GSCHED_RELEASE;
+    return 1;
+}
+
+bool_t cuda_graph_exec_destroy_1_svc(ptr graph_exec, int *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    *result = cuGraphExecDestroy((CUgraphExec)graph_exec);
+    GSCHED_RELEASE;
+    return 1;
+}
+
+bool_t cuda_graph_instantiate_1_svc(ptr graph, uint64_t flags, ptr_result *result, struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    CUgraphExec graph_exec = NULL;
+    result->err = cuGraphInstantiate(&graph_exec, (CUgraph)graph, flags);
+    if (result->err == cudaSuccess) result->ptr_result_u.ptr = (ptr)graph_exec;
+    GSCHED_RELEASE;
+    return 1;
+}
+
+bool_t cuda_graph_launch_1_svc(ptr graph_exec, ptr stream, int *result, struct svc_req *rqstp)
