diff --git a/cpu/cpu-common.h b/cpu/cpu-common.h
--- a/cpu/cpu-common.h
+++ b/cpu/cpu-common.h
@@ -19,6 +19,7 @@ typedef struct kernel_info {
     uint16_t *param_offsets;
     uint16_t *param_sizes;
     void *host_fun;
+    void *module;
 } kernel_info_t;
 
 enum socktype_t {UNIX, TCP, UDP} socktype;
diff --git a/cpu/cpu-elf2.c b/cpu/cpu-elf2.c
--- a/cpu/cpu-elf2.c
+++ b/cpu/cpu-elf2.c
@@ -891,6 +891,7 @@ int elf2_parameter_info(list *kernel_infos, void* memory, size_t memsize)
     int ret = -1;
     kernel_info_t *ki = NULL;
     const char *kernel_str;
+    size_t initial_kernel_count = kernel_infos != NULL ? kernel_infos->length : 0;
 
     if (memory == NULL || memsize == 0) {
         LOGE(LOG_ERROR, "memory was NULL or memsize was 0");
@@ -969,7 +970,19 @@ int elf2_parameter_info(list *kernel_infos, void* memory, size_t memsize)
             continue;
         }
 
-        if (utils_search_info(kernel_infos, kernel_str) != NULL) {
+        /* Kernel names are only unique within one module.  Preserve a record
+         * for the same-named kernel in every separately loaded JIT module. */
+        int found_in_module = 0;
+        for (size_t kernel_idx = initial_kernel_count;
+             kernel_idx < kernel_infos->length; ++kernel_idx) {
+            kernel_info_t *existing = NULL;
+            if (list_at(kernel_infos, kernel_idx, (void **)&existing) == 0 &&
+                existing != NULL && strcmp(existing->name, kernel_str) == 0) {
+                found_in_module = 1;
+                break;
+            }
+        }
+        if (found_in_module) {
             continue;
         }
 
