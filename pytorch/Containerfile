FROM docker.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04@sha256:ad6d59a3bbf3e82c1c849c9ac09cfc2a3e0bbb8655042fd899be6681b3fe2a85

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:/work/venv/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64 \
    CMAKE_GENERATOR=Ninja \
    MAX_JOBS=8 \
    BUILD_TEST=0 \
    USE_CUDA=1 \
    USE_CUDNN=1 \
    USE_DISTRIBUTED=0 \
    USE_NCCL=0 \
    USE_MPI=0 \
    USE_GLOO=0 \
    USE_KINETO=0 \
    USE_FBGEMM=0 \
    USE_MKLDNN=0 \
    USE_QNNPACK=0 \
    USE_XNNPACK=0 \
    USE_NNPACK=0 \
    TORCH_CUDA_ARCH_LIST=12.0+PTX \
    CUDA_NVCC_FLAGS=-cudart=shared \
    EXTRA_NVCCFLAGS=-cudart=shared \
    NVCC_APPEND_FLAGS=-cudart=shared \
    CAFFE2_STATIC_LINK_CUDA=0 \
    PYTORCH_BUILD_VERSION=2.11.0+flyt.cu128 \
    PYTORCH_BUILD_NUMBER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ccache cmake curl g++ gcc git libblas-dev \
      liblapack-dev libnuma-dev ninja-build patchelf pkg-config \
      python3 python3-dev python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /work/venv && \
    /work/venv/bin/pip install --no-cache-dir --upgrade \
      pip 'setuptools<82,>=70.1.0' wheel && \
    /work/venv/bin/pip install --no-cache-dir \
      astunparse expecttest filelock fsspec hypothesis jinja2 \
      lintrunner networkx numpy optree packaging psutil pyyaml \
      requests six sympy typing-extensions

WORKDIR /build
ENTRYPOINT ["/bin/bash", "/input/build-inside.sh"]
