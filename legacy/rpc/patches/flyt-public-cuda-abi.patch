diff --git a/cpu/flyt-public-cuda.map b/cpu/flyt-public-cuda.map
new file mode 100644
index 0000000..24eeea1
--- /dev/null
+++ b/cpu/flyt-public-cuda.map
@@ -0,0 +1,32 @@
+libcublas.so.12 {
+    global:
+        cublas*;
+};
+
+libcublasLt.so.12 {
+    global:
+        cublasLt*;
+};
+
+libcusolver.so.11 {
+    global:
+        cusolver*;
+};
+
+libcudnn.so.9 {
+    global:
+        cudnn*;
+};
+
+libcudart.so.12 {
+    global:
+        cuda*;
+        __cuda*;
+        cu[A-Z]*;
+    local:
+        *;
+};
+
+# Validated hybrid vendor ABIs use Flyt RPC instead of depending on NVIDIA's
+# private cuGetExportTable ABI. Other vendor libraries remain native until
+# their wrappers are validated.
