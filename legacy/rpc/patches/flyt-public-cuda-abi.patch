diff --git a/cpu/Makefile b/cpu/Makefile
index 17d3ca0..c0f0f01 100644
--- a/cpu/Makefile
+++ b/cpu/Makefile
@@ -110,6 +110,7 @@ endif
 SERVER_METRICS_FLAGS =  -lnvperf_host -lnvperf_target -L $(METRICS_SRC)/ -lprofiler -lstdc++ -lm
 SERVER_BIN_LD_FLAGS = $(SERVER_LD_FLAGS) -Wl,--unresolved-symbols=ignore-in-object-files
 CLIENT_LD_FLAGS = -Wl,-soname,$(CLIENT_TARGET_LIB) $(LD_FLAGS) -lrt
+CLIENT_LD_FLAGS += -Wl,--version-script=flyt-public-cuda.map
 
 # Targets
 .PHONY: all clean
@@ -145,6 +146,6 @@ $(CLIENT_STATIC): $(OBJ_CLIENT)
 	ar rcs $@ $^
 
-$(CLIENT) : $(OBJ_CLIENT) 
+$(CLIENT) : $(OBJ_CLIENT) flyt-public-cuda.map
