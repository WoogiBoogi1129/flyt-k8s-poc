     return 1;
 }
 
+bool_t rpc_cufuncgetattribute_1_svc(int attrib, ptr function,
+                                    int_result *result,
+                                    struct svc_req *rqstp)
+{
+    GSCHED_RETAIN;
+    GET_CLIENT_DRV(result->err);
+
+    addr_data_pair_t *func_info = NULL;
+    if (resource_mg_get(&client->functions, (void *)function,
+                        (void **)&func_info) != 0 || func_info == NULL) {
+        LOGE(LOG_ERROR, "function not found in resource manager");
+        result->err = CUDA_ERROR_INVALID_HANDLE;
+        GSCHED_RELEASE;
+        return 1;
+    }
+
+    result->err = cuFuncGetAttribute(&result->int_result_u.data,
+                                     (CUfunction_attribute)attrib,
+                                     (CUfunction)func_info->addr);
+    GSCHED_RELEASE;
+    return 1;
+}
