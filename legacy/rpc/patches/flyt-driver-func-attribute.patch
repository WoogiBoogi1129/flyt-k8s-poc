diff --git a/cpu/cpu-client-driver.c b/cpu/cpu-client-driver.c
index a353b83..ba33b4e 100644
--- a/cpu/cpu-client-driver.c
+++ b/cpu/cpu-client-driver.c
@@ -673,1 +673,21 @@
-DEF_FN(CUresult, cuFuncGetAttribute, int*, pi, CUfunction_attribute, attrib, CUfunction, hfunc)
+CUresult cuFuncGetAttribute(int *pi, CUfunction_attribute attrib,
+                            CUfunction hfunc)
+{
+    if (pi == NULL || hfunc == NULL) {
+        return CUDA_ERROR_INVALID_VALUE;
+    }
+    int_result result = { .err = CUDA_ERROR_UNKNOWN };
+    enum clnt_stat retval;
+    FUNC_BEGIN
+    retval = rpc_cufuncgetattribute_1(attrib, (uint64_t)hfunc,
+                                      &result, clnt);
+    FUNC_END
+    if (retval != RPC_SUCCESS) {
+        LOGE(LOG_ERROR, "%s RPC failed (%d)", __FUNCTION__, retval);
+        return CUDA_ERROR_UNKNOWN;
+    }
+    if (result.err == CUDA_SUCCESS) {
+        *pi = result.int_result_u.data;
+    }
+    return result.err;
+}
