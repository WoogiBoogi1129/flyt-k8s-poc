+static int hainfo_getfreeindex(void)
+{
+    size_t i;
+
+    for (i = 0; i < hainfo_cnt; ++i) {
+        if (hainfo[i].client_ptr == NULL) {
+            return (int)i;
+        }
+    }
+    if (hainfo_cnt >= sizeof(hainfo) / sizeof(hainfo[0])) {
+        return -1;
+    }
+    return (int)hainfo_cnt;
+}
+
+static int hainfo_add(void *client_ptr, size_t size, int idx)
+{
+    int slot = hainfo_getfreeindex();
+
+    if (slot < 0) {
+        return -1;
+    }
+    hainfo[slot].idx = idx;
+    hainfo[slot].size = size;
+    hainfo[slot].client_ptr = client_ptr;
+    if ((size_t)slot == hainfo_cnt) {
+        hainfo_cnt++;
+    }
+    return slot;
+}
