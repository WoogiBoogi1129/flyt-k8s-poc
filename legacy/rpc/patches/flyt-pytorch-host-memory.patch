+        dlsym(libwrap_get_sohandle(), "cudaPointerGetAttributes");
+    error_str = dlerror();
+    if (error_str != NULL || real_cuda_pointer_get_attributes == NULL) {
+        LOGE(LOG_ERROR, "[libwrap] %s",
