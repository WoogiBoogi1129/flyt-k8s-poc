# Copy this file to config.env and replace every REPLACE_* value.
FLYT_NAMESPACE=flyt-system
NODE_NAME=REPLACE_WITH_GPU_NODE
GPU_UUID=REPLACE_WITH_PARENT_GPU_UUID
GPU_PARENT_MINOR=REPLACE_WITH_PARENT_GPU_MINOR
GPU_MODE=mig
MIG_PROFILE=1g.24gb
EXPECTED_MIG_SM=46
STORAGE_CLASS=local-path
RUN_DYNAMIC=false

# Public key is rendered into KubeVirt cloud-init. The private key stays local.
SSH_PUBLIC_KEY='REPLACE_WITH_SSH_PUBLIC_KEY'
SSH_KEY='REPLACE_WITH_PRIVATE_KEY_PATH'
VIRTCTL=virtctl

VM_A=flyt-vm-a
VM_B=flyt-vm-b
VM_CONTAINERDISK_IMAGE='quay.io/containerdisks/ubuntu@sha256:2fffdab355e5bede76ffbb362bb5751e9df100579f4313ea3e2077a5d5b3538a'

FLYT_REPOSITORY='https://github.com/WoogiBoogi1129/flyt_custom_for_k8s.git'
FLYT_COMMIT=596a86939bae125d127a9ed6f70d92c332f47644
PYTORCH_REPOSITORY='https://github.com/pytorch/pytorch.git'
PYTORCH_COMMIT=70d99e998b4955e0049d13a98d77ae1b14db1f45
RUST_TOOLCHAIN=1.97.1
