{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "flytgpuprofiles.flyt.dev",
    "labels": {
      "flyt.dev/control-plane-api": "shm-stage1"
    }
  },
  "spec": {
    "group": "flyt.dev",
    "scope": "Namespaced",
    "names": {
      "kind": "FlytGPUProfile",
      "listKind": "FlytGPUProfileList",
      "plural": "flytgpuprofiles",
      "singular": "flytgpuprofile",
      "shortNames": [
        "fgp"
      ]
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Ready",
            "type": "string",
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status"
          },
          {
            "name": "Consumers",
            "type": "integer",
            "jsonPath": ".status.consumers"
          },
          {
            "name": "Age",
            "type": "date",
            "jsonPath": ".metadata.creationTimestamp"
          }
        ],
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "required": [
              "spec"
            ],
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "required": [
                  "nodeName",
                  "gpuUUID",
                  "cores",
                  "memoryMiB",
                  "workerImage",
                  "hamiNamespace"
                ],
                "properties": {
                  "approved": {
                    "type": "boolean",
                    "default": false
                  },
                  "nodeName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "gpuUUID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^GPU-[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
                  },
                  "cores": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 256,
                    "maximum": 1048576
                  },
                  "maxClients": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 1,
                    "maximum": 32,
                    "default": 8
                  },
                  "workerImage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
                  },
                  "runtimeClass": {
                    "type": "string",
                    "default": "",
                    "maxLength": 253
                  },
                  "hamiNamespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "schedulerName": {
                    "type": "string",
                    "default": "hami-scheduler",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "self.nodeName == oldSelf.nodeName",
                    "message": "nodeName is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.gpuUUID == oldSelf.gpuUUID",
                    "message": "gpuUUID is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.cores == oldSelf.cores",
                    "message": "cores is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.memoryMiB == oldSelf.memoryMiB",
                    "message": "memoryMiB is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.maxClients == oldSelf.maxClients",
                    "message": "maxClients is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.workerImage == oldSelf.workerImage",
                    "message": "workerImage is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.runtimeClass == oldSelf.runtimeClass",
                    "message": "runtimeClass is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.hamiNamespace == oldSelf.hamiNamespace",
                    "message": "hamiNamespace is immutable; create a new resource or clean up the old allocation first"
                  },
                  {
                    "rule": "self.schedulerName == oldSelf.schedulerName",
                    "message": "schedulerName is immutable; create a new resource or clean up the old allocation first"
                  }
                ]
              },
              "status": {
                "type": "object",
                "properties": {
                  "observedGeneration": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "phase": {
                    "type": "string",
                    "enum": [
                      "Pending",
                      "Ready",
                      "Blocked",
                      "Suspended",
                      "Terminating"
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "x-kubernetes-list-type": "map",
                    "x-kubernetes-list-map-keys": [
                      "type"
                    ],
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "status",
                        "lastTransitionTime",
                        "reason",
                        "message"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 316
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "True",
                            "False",
                            "Unknown"
                          ]
                        },
                        "lastTransitionTime": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 8192
                        },
                        "observedGeneration": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    }
                  },
                  "consumers": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "podUID": {
                    "type": "string"
                  },
                  "podIP": {
                    "type": "string"
                  },
                  "vmIP": {
                    "type": "string"
                  },
                  "workerGeneration": {
                    "type": "string"
                  },
                  "managerEpoch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
