{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "mode",
    "image"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "review",
        "active"
      ]
    },
    "activeModeAcknowledged": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "tolerations": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "tolerations": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "reconcileSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "maxBackoffSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "readyStaleSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "logLevel": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    }
  }
}
